# Copy to .env for local development. Never commit real credentials.
APP_NAME=BiteGuard Platform
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_HOST=localhost
DATABASE_PORT=1433
DATABASE_NAME=BiteGuardDB
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_DRIVER=ODBC Driver 18 for SQL Server
# Keep false unless you deliberately need this for a local-only development instance.
DATABASE_TRUST_SERVER_CERTIFICATE=false
# Set true when using Windows Authentication; otherwise provide user/password.
DATABASE_WINDOWS_AUTHENTICATION=false
